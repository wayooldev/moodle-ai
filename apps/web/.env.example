# Clerk
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# Neon + crypto (same values as MCP)
DATABASE_URL=
TOKEN_ENCRYPTION_KEY=

# MCP handoff for Alexa authorization codes
MCP_BASE_URL=http://127.0.0.1:3000
INTERNAL_API_KEY=
NEXT_PUBLIC_MCP_BASE_URL=http://127.0.0.1:3000

# Observability / rate limit (optional locally; required in production for full P0)
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Gemini (AI Studio free tier) — required for /api/chat
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional override; default is gemini-3.5-flash-lite (free Flash-Lite)
# GEMINI_MODEL=gemini-3.5-flash-lite

# Langfuse (optional; chat traces with secret scrubbing)
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# CI / local: SKIP_ENV_VALIDATION=1 to bypass @t3-oss/env-nextjs when keys are placeholders
# SKIP_ENV_VALIDATION=
