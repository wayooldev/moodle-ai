# Moodle AI — local secrets (never commit)
# Copy to apps/mcp/.env and apps/web/.env.local as needed.

DATABASE_URL=
TOKEN_ENCRYPTION_KEY=
MCP_API_KEY=
MOODLE_URL=
MOODLE_TOKEN=
PORT=3000
PUBLIC_BASE_URL=https://mcp-lms.wayool.com
WEB_APP_URL=http://localhost:3001
ALEXA_OAUTH_CLIENT_ID=
ALEXA_OAUTH_CLIENT_SECRET=
INTERNAL_API_KEY=

# Observability (optional locally)
SENTRY_DSN=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Web chat (Gemini free tier via AI Studio) + Langfuse (optional)
GOOGLE_GENERATIVE_AI_API_KEY=
# Optional: GEMINI_MODEL=gemini-3.5-flash-lite
LANGFUSE_SECRET_KEY=
LANGFUSE_PUBLIC_KEY=
LANGFUSE_BASE_URL=

# Set to 1 only in CI/local smoke when you intentionally skip typed env checks
# SKIP_ENV_VALIDATION=
